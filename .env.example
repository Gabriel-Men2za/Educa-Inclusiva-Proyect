# SMTP_USER y SMTP_PASS son credenciales locales; no las compartas.
SMTP_PROVIDER=gmail
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_EMAIL=
APP_URL=
APP_BASE_URL=

# Gmail: pega SMTP_PASS en tu archivo .env local usando una contraseña de aplicación, no la contraseña normal.
# Outlook/Microsoft 365: SMTP_USER debe ser una cuenta con SMTP AUTH habilitado.
